<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>xyz.lemone.zephyr</groupId>
    <artifactId>zephyr</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Zephyr</name>
    <description>和风 · 微风 — 多模块基础系统</description>
    <url>https://github.com/Inventor-dev/zephyr</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Boot -->
        <spring-boot.version>4.0.0</spring-boot.version>

        <!-- ORM -->
        <fluent-mybatis.version>1.9.10</fluent-mybatis.version>

        <!-- Database -->
        <mysql.version>9.1.0</mysql.version>
        <druid.version>1.2.23</druid.version>

        <!-- Cache -->
        <redisson.version>3.37.0</redisson.version>

        <!-- Auth -->
        <sa-token.version>1.39.0</sa-token.version>

        <!-- API Doc -->
        <springdoc.version>2.8.3</springdoc.version>

        <!-- Utils -->
        <hutool.version>5.8.32</hutool.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.38</lombok.version>

        <!-- Gateway -->
        <spring-cloud.version>2024.0.1</spring-cloud.version>
    </properties>

    <modules>
        <module>zephyr-common</module>
        <module>zephyr-auth</module>
        <module>zephyr-system</module>
        <module>zephyr-permission</module>
        <module>zephyr-dict</module>
        <module>zephyr-log</module>
        <module>zephyr-form</module>
        <module>zephyr-extension</module>
        <module>zephyr-file</module>
        <module>zephyr-job</module>
        <module>zephyr-notification</module>
        <module>zephyr-monitor</module>
        <module>zephyr-codegen</module>
        <module>zephyr-gateway</module>
        <module>zephyr-admin</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-common-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-common-security</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 业务模块 -->
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-permission</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-dict</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-form</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-extension</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-job</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-monitor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-codegen</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.lemone.zephyr</groupId>
                <artifactId>zephyr-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Fluent-MyBatis -->
            <dependency>
                <groupId>com.github.atool</groupId>
                <artifactId>fluent-mybatis</artifactId>
                <version>${fluent-mybatis.version}</version>
            </dependency>

            <!-- MySQL -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- Druid -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>

            <!-- Sa-Token -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- SpringDoc -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Lombok 全局 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>1.15.1</version>
                    <configuration>
                        <nodeVersion>v20.11.0</nodeVersion>
                        <pnpmVersion>9.1.0</pnpmVersion>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
